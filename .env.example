# Optional: Formspree form ID (e.g. xayzbqwe). If unset, the contact form opens a prefilled mailto link.
NEXT_PUBLIC_FORMSPREE_ID=

# Sub-path for GitHub Pages project sites (e.g. /marcreantaso-porftfolio). Leave empty for root hosting.
NEXT_PUBLIC_BASE_PATH=

# Canonical origin used in metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://marcreantaso.github.io
